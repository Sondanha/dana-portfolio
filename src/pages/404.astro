---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다 | Son Danha" description="요청한 페이지를 찾을 수 없습니다.">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-5 py-20">
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(23,36,62,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(23,36,62,0.04)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
    <div class="relative z-10 text-center">
      <p class="text-sm font-semibold tracking-[0.24em] text-[var(--color-accent)]">404</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-5xl">페이지를 찾을 수 없습니다.</h1>
      <p class="mt-5 text-sm text-[var(--color-text-secondary)] sm:text-base">주소를 다시 확인하거나 홈으로 돌아가 주세요.</p>
      <a href="/" class="mt-9 inline-flex items-center justify-center rounded-lg border border-[var(--color-accent)] bg-[var(--color-accent)] px-6 py-3 text-sm text-white transition-colors hover:bg-white hover:text-[var(--color-accent)]">
        홈으로 돌아가기
      </a>
    </div>
  </main>
</BaseLayout>
