---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import portfolioData from '../data/portfolio.json';

const { contact, meta } = portfolioData;
---

<BaseLayout title="Contact | Son Danha" description="손단하에게 프로젝트와 협업에 관한 이야기를 남겨주세요.">
  <Header navItems={[]} />

  <main class="contact-page relative flex min-h-screen items-center overflow-hidden px-5 pb-12 pt-28 sm:px-8 sm:pb-16 sm:pt-32">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(23,36,62,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(23,36,62,0.04)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
      <div class="absolute -left-28 top-10 h-80 w-80 rounded-full border-[32px] border-[var(--color-brand-coral)] opacity-[0.07]"></div>
      <img src="/favicon.png" alt="" aria-hidden="true" class="absolute -right-24 bottom-[-5rem] w-[34rem] opacity-[0.055] sm:right-[2%] sm:w-[42rem]" width="672" height="672" />
    </div>

    <div class="relative z-10 mx-auto w-full max-w-5xl overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-[0_28px_90px_rgba(23,36,62,0.13)]">
      <a href="/" class="absolute right-5 top-5 z-20 flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-white text-[var(--color-text-secondary)] shadow-sm transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]" aria-label="포트폴리오로 돌아가기">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.8" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </a>
      <div class="px-6 pb-4 pt-8 sm:px-10 sm:pt-10">
        <h1 class="pr-14 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">{contact.headline}</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">{contact.description}</p>
      </div>

      <div class="grid grid-cols-2 border-b border-[var(--color-border)] px-6 pt-2 sm:px-10" role="tablist" aria-label="연락 방법 선택">
        <button type="button" role="tab" aria-selected="true" aria-controls="contact-message-panel" data-contact-tab="message" class="contact-tab relative px-3 py-4 text-center text-sm font-bold text-[var(--color-text-primary)]">
          문의 남기기
          <span class="contact-tab-line is-active" aria-hidden="true"></span>
        </button>
        <button type="button" role="tab" aria-selected="false" aria-controls="contact-email-panel" data-contact-tab="email" class="contact-tab relative px-3 py-4 text-center text-sm font-semibold text-[var(--color-text-tertiary)]">
          이메일 주소
          <span class="contact-tab-line" aria-hidden="true"></span>
        </button>
      </div>

      <div class="h-[29rem] overflow-y-auto sm:h-[27rem]">
        <div id="contact-message-panel" role="tabpanel" data-contact-panel="message" class="h-full p-6 sm:p-8 sm:px-10">
          <form id="contact-form" class="flex h-full flex-col gap-5">
            <div>
              <label for="contact-email" class="mb-2 block text-sm font-bold text-[var(--color-text-primary)]">답변받을 이메일</label>
              <input id="contact-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" class="w-full rounded-lg border border-[var(--color-border)] bg-white px-4 py-3 text-[var(--color-text-primary)] outline-none transition focus:border-[var(--color-accent)] focus:ring-4 focus:ring-[var(--color-accent-subtle)]" />
            </div>
            <div>
              <label for="contact-message" class="mb-2 block text-sm font-bold text-[var(--color-text-primary)]">문의 내용</label>
              <textarea id="contact-message" name="message" required minlength="10" maxlength="2000" rows="5" placeholder="프로젝트, 협업 또는 나누고 싶은 이야기를 적어주세요." class="w-full resize-none rounded-lg border border-[var(--color-border)] bg-white px-4 py-3 text-[var(--color-text-primary)] outline-none transition focus:border-[var(--color-accent)] focus:ring-4 focus:ring-[var(--color-accent-subtle)]"></textarea>
            </div>
            <div class="hidden" aria-hidden="true">
              <label for="contact-website">Website</label>
              <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="mt-auto flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p id="contact-form-status" class="min-h-5 text-sm text-[var(--color-text-secondary)]" aria-live="polite"></p>
              <button id="contact-submit" type="submit" class="inline-flex items-center justify-center rounded-lg border border-[var(--color-accent)] bg-[var(--color-accent)] px-6 py-3 text-sm font-normal text-white transition-colors hover:bg-white hover:text-[var(--color-accent)] disabled:cursor-not-allowed disabled:opacity-60">문의 보내기</button>
            </div>
          </form>
        </div>

        <div id="contact-email-panel" role="tabpanel" data-contact-panel="email" class="hidden h-full p-6 pt-20 sm:px-10 sm:pt-24">
          <div class="flex h-full flex-col items-center text-center">
            <button type="button" data-copy-email data-email={meta.email} class="w-fit max-w-full break-all text-center text-2xl font-bold tracking-tight text-[var(--color-text-primary)] transition-colors hover:text-[var(--color-accent)] sm:text-3xl" aria-label={`${meta.email} 복사`}>
              {meta.email}
            </button>
            <p class="mt-7 text-[var(--color-text-secondary)]">메일 주소를 복사하거나 기본 메일 앱에서 바로 연락할 수 있습니다.</p>
            <div class="mt-auto grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2">
              <button id="copy-email" type="button" data-copy-email data-email={meta.email} class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-[var(--color-accent)] bg-[var(--color-accent)] px-5 py-3 text-sm font-normal text-white transition-colors hover:bg-white hover:text-[var(--color-accent)]">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="8" y="8" width="11" height="11" rx="2" stroke-width="1.8" />
                  <path stroke-linecap="round" stroke-width="1.8" d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
                </svg>
                <span id="copy-email-label">{contact.emailLabel}</span>
              </button>
              <a href={`mailto:${meta.email}`} class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-[var(--color-border)] px-5 py-3 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6.5h16v11H4zM4 7l8 6 8-6" />
                </svg>
                메일 앱 열기
              </a>
            </div>
            <p id="copy-email-status" class="mt-3 min-h-5 text-sm text-[var(--color-text-secondary)]" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-contact-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-contact-panel]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.contactTab;
      tabs.forEach((item) => {
        const isActive = item === tab;
        item.setAttribute('aria-selected', String(isActive));
        item.classList.toggle('text-[var(--color-text-primary)]', isActive);
        item.classList.toggle('text-[var(--color-text-tertiary)]', !isActive);
        item.querySelector('.contact-tab-line')?.classList.toggle('is-active', isActive);
      });
      panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.contactPanel !== target));
    });
  });

  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const formStatus = document.getElementById('contact-form-status');

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitButton || !formStatus) return;
    submitButton.disabled = true;
    formStatus.textContent = '보내는 중입니다…';
    const payload = Object.fromEntries(new FormData(contactForm).entries());

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || '메시지를 보내지 못했습니다.');
      contactForm.reset();
      formStatus.textContent = '문의가 전송되었습니다. 확인 후 답장드릴게요.';
    } catch (error) {
      formStatus.textContent = error instanceof Error ? error.message : '잠시 후 다시 시도해주세요.';
    } finally {
      submitButton.disabled = false;
    }
  });

  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-email]');
  const copyLabel = document.getElementById('copy-email-label');
  const copyStatus = document.getElementById('copy-email-status');

  copyButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        if (copyLabel) copyLabel.textContent = '복사 완료';
        if (copyStatus) copyStatus.textContent = `${email} 복사 완료`;
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = '이메일 주소 복사';
          if (copyStatus) copyStatus.textContent = '';
        }, 2400);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
