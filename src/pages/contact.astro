---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import AboutGlassSurface from '../components/ui/AboutGlassSurface';
import { LiquidActionLink, LiquidActionButton } from '../components/ui/LiquidHeroGlass';
import portfolioData from '../data/portfolio.json';

const { contact, meta } = portfolioData;
const gmailComposeUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(meta.email)}`;
---

<BaseLayout title="Contact | Son Danha" description="손단하에게 프로젝트와 협업에 관한 이야기를 남겨주세요.">
  <Header navItems={[]} />

  <main class="contact-page relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-5 pb-12 pt-28 sm:px-8 sm:pb-16 sm:pt-32">
    <div class="contact-glass-panel relative z-10 mx-auto w-full max-w-3xl overflow-hidden rounded-[36px] border border-[rgba(255,255,255,0.28)]">
      <div class="absolute inset-0 z-0" aria-hidden="true">
        <AboutGlassSurface client:load className="card-glass-surface w-full h-full" />
      </div>
      
      <!-- X 닫기 버튼 (우측 상단) -->
      <a href="/" class="glass-chip absolute right-6 top-6 z-20 flex h-11 w-11 items-center justify-center rounded-full border text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]" aria-label="메인 화면으로 돌아가기">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.8" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </a>

      <div class="relative z-10 flex min-h-[32rem] flex-col items-center px-6 py-12 text-center sm:px-12 sm:py-16">
        
        <!-- 상단 헤더 영역 -->
        <div>
          <h1 class="text-2xl font-normal uppercase tracking-[0.15em] text-[var(--color-accent)] sm:text-3xl">Contact</h1>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-black sm:text-base">{contact.description}</p>
        </div>

        <!-- 중앙 이메일 영역 (가운데 정렬) -->
        <div class="my-auto flex flex-col items-center justify-center py-8">
          <button type="button" data-copy-email data-email={meta.email} class="w-fit max-w-full break-all text-center text-2xl font-bold tracking-tight text-[var(--color-text-primary)] transition-colors hover:text-[var(--color-accent)] sm:text-3xl" aria-label={`${meta.email} 복사`}>
            {meta.email}
          </button>
        </div>

        <!-- 하단 버튼 영역 -->
        <div class="mt-auto flex w-full max-w-md flex-col items-center justify-center gap-4 sm:flex-row">
          <LiquidActionButton 
            client:load 
            label={contact.emailLabel} 
            variant="clear" 
            icon="copy" 
            data-copy-email={true} 
            data-email={meta.email} 
            fullWidth={true}
            className="text-[var(--color-text-primary)] font-semibold"
          />
          <LiquidActionLink 
            client:load 
            label="Gmail에서 메일 쓰기" 
            href={gmailComposeUrl} 
            variant="clear" 
            icon="external" 
            external={true}
            fullWidth={true}
            className="text-[var(--color-text-primary)] font-semibold"
          />
        </div>
        <p id="copy-email-status" class="mt-3 min-h-5 text-sm font-semibold text-[var(--color-accent)]" aria-live="polite"></p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-email]');
  const copyLabels = document.querySelectorAll<HTMLElement>('[data-copy-email-label]');
  const copyStatus = document.getElementById('copy-email-status');

  copyButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        copyLabels.forEach((label) => (label.textContent = '복사 완료'));
        if (copyStatus) copyStatus.textContent = `${email} 복사 완료`;
        window.setTimeout(() => {
          copyLabels.forEach((label) => (label.textContent = '이메일 주소 복사'));
          if (copyStatus) copyStatus.textContent = '';
        }, 2400);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
