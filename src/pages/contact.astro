---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import portfolioData from '../data/portfolio.json';

const { contact, meta } = portfolioData;
const gmailComposeUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(meta.email)}`;
---

<BaseLayout title="Contact | Son Danha" description="손단하에게 프로젝트와 협업에 관한 이야기를 남겨주세요.">
  <Header navItems={[]} />

  <main class="contact-page relative flex min-h-screen items-center overflow-hidden px-5 pb-12 pt-28 sm:px-8 sm:pb-16 sm:pt-32">
    <div class="liquid-panel relative z-10 mx-auto w-full max-w-3xl overflow-hidden rounded-[22px]">
      <a href="/" class="glass-chip absolute right-5 top-5 z-20 flex h-11 w-11 items-center justify-center rounded-full border text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]" aria-label="포트폴리오로 돌아가기">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.8" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </a>
      <div class="flex min-h-[28rem] flex-col items-center justify-center px-6 pb-12 pt-16 text-center sm:px-12 sm:pb-16 sm:pt-20">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)]">{contact.eyebrow}</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">{contact.headline}</h1>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">{contact.description}</p>

        <button type="button" data-copy-email data-email={meta.email} class="mt-12 w-fit max-w-full break-all text-center text-2xl font-bold tracking-tight text-[var(--color-text-primary)] transition-colors hover:text-[var(--color-accent)] sm:text-3xl" aria-label={`${meta.email} 복사`}>
          {meta.email}
        </button>
        <p class="mt-4 text-sm text-[var(--color-text-secondary)]">메일 주소를 복사하거나 Gmail에서 바로 연락할 수 있습니다.</p>

        <div class="mt-10 grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2">
          <button type="button" data-copy-email data-email={meta.email} class="tinted-glass inline-flex w-full items-center justify-center gap-2 rounded-full border px-5 py-3 text-sm font-normal text-white transition-colors">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="11" height="11" rx="2" stroke-width="1.8" />
              <path stroke-linecap="round" stroke-width="1.8" d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
            </svg>
            <span data-copy-email-label>{contact.emailLabel}</span>
          </button>
          <a href={gmailComposeUrl} target="_blank" rel="noopener noreferrer" class="glass-chip inline-flex w-full items-center justify-center gap-2 rounded-full border px-5 py-3 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6.5h16v11H4zM4 7l8 6 8-6" />
            </svg>
            Gmail에서 메일 쓰기
          </a>
        </div>
        <p id="copy-email-status" class="mt-4 min-h-5 text-sm text-[var(--color-text-secondary)]" aria-live="polite"></p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-email]');
  const copyLabels = document.querySelectorAll<HTMLElement>('[data-copy-email-label]');
  const copyStatus = document.getElementById('copy-email-status');

  copyButtons.forEach((copyButton) => {
    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        copyLabels.forEach((label) => (label.textContent = '복사 완료'));
        if (copyStatus) copyStatus.textContent = `${email} 복사 완료`;
        window.setTimeout(() => {
          copyLabels.forEach((label) => (label.textContent = '이메일 주소 복사'));
          if (copyStatus) copyStatus.textContent = '';
        }, 2400);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
