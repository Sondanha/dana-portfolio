---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import portfolioData from '../data/portfolio.json';

const studyProjects = portfolioData.projects.filter((project) => !project.featured);
const studyNavItems = studyProjects.map((project) => ({
  label: project.title.split(' — ')[0],
  href: `/study#${project.id}`,
}));

const getProjectName = (title: string) => title.split(' — ')[0];
const projectPeriods: Record<string, string> = {
  'heogayo-legal-rag': '25.05 - 25.07',
  'polo-paper-ai': '25.07 - 25.09',
  'patent-llama-finetuning': '25.10',
  'crate-selection-platform': '25.12 - 26.01',
};

const getProjectLinks = (project: (typeof studyProjects)[number]) => [
  project.links.live && { label: '서비스 보기', href: project.links.live },
  project.links.github && { label: 'GitHub Repository', href: project.links.github },
  project.links.secondary && {
    label: project.links.secondaryLabel || '관련 Repository',
    href: project.links.secondary,
  },
].filter(Boolean) as Array<{ label: string; href: string }>;
---

<BaseLayout
  title="Study Projects | Son Danha"
  description="손단하가 배우고 협업하며 만든 프로젝트를 한 페이지에서 소개합니다."
>
  <Header navItems={studyNavItems} />

  <main class="study-page min-h-screen overflow-hidden bg-white pb-24 pt-28 sm:pt-36">
    <section class="relative px-6 pb-20 sm:pb-28">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 bg-[linear-gradient(rgba(23,36,62,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(23,36,62,0.035)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
        <div class="absolute -right-28 top-4 h-80 w-80 rounded-full border-[28px] border-[var(--color-accent)] opacity-[0.06]"></div>
      </div>

      <div class="relative mx-auto max-w-6xl">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-[var(--color-accent)]">Study Projects</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-6xl">
          배우고 협업하며 만든 프로젝트
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-text-secondary)] sm:text-lg">
          팀과 함께 실험하고 구현한 프로젝트를 모았습니다. 각 프로젝트의 상세 내용은 앞으로 이 페이지에서 계속 보강합니다.
        </p>

        <nav class="study-timeline mt-12 overflow-x-auto pb-4" aria-label="스터디 프로젝트 타임라인">
          <ol class="flex min-w-[46rem]">
            {studyProjects.map((project) => (
              <li class="study-timeline-item relative flex-1">
                <a href={`#${project.id}`} class="group flex flex-col items-center px-3 text-center">
                  <span class="text-xs font-medium tracking-[0.14em] text-[var(--color-text-tertiary)]">
                    {projectPeriods[project.id]}
                  </span>
                  <span class="study-timeline-node mt-3" aria-hidden="true"></span>
                  <span class="mt-3 text-sm font-bold text-[var(--color-text-primary)] transition-colors group-hover:text-[var(--color-accent)]">
                    {getProjectName(project.title)}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </section>

    <div class="mx-auto max-w-6xl border-t border-[var(--color-border)] px-6">
      {studyProjects.map((project, index) => {
        const projectLinks = getProjectLinks(project);

        return (
          <section
            id={project.id}
            class="grid scroll-mt-28 gap-8 border-b border-[var(--color-border)] py-16 sm:py-24 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16"
          >
            <div class="lg:sticky lg:top-28 lg:self-start">
              <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-[var(--color-bg-secondary)]">
                <img
                  src={project.thumbnail}
                  alt={`${getProjectName(project.title)} 프로젝트 이미지`}
                  class:list={[
                    'h-full w-full object-cover',
                    project.thumbnailPosition === 'top' ? 'object-top' : 'object-center',
                  ]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>

            <div class="flex min-h-[22rem] flex-col justify-center">
              <p class="text-sm font-bold tracking-[0.18em] text-[var(--color-accent)]">
                {projectPeriods[project.id]}
              </p>

              <h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
                {project.title}
              </h2>
              <p class="mt-6 whitespace-pre-line text-base leading-8 text-[var(--color-text-secondary)]">
                {project.description}
              </p>

              <ul class="mt-7 flex flex-wrap gap-2" aria-label={`${getProjectName(project.title)} 기술`}>
                {project.tags.map((tag) => (
                  <li class="rounded-full bg-[var(--color-bg-secondary)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text-secondary)]">
                    {tag}
                  </li>
                ))}
              </ul>

              <div class="mt-9 flex flex-wrap gap-3">
                {projectLinks.map((link, linkIndex) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      'inline-flex w-full items-center justify-center gap-2 rounded-lg border px-5 py-3 text-sm font-semibold transition-colors sm:w-52',
                      linkIndex === 0
                        ? 'border-[var(--color-accent)] bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)]'
                        : 'border-[var(--color-border)] bg-white text-[var(--color-text-primary)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]',
                    ]}
                  >
                    {link.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        );
      })}
    </div>

    <div class="mx-auto mt-12 flex max-w-6xl px-6">
      <a href="/#projects" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-accent)]">
        <span aria-hidden="true">←</span>
        포트폴리오 프로젝트로 돌아가기
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .study-timeline {
    scrollbar-width: none;
  }

  .study-timeline::-webkit-scrollbar {
    display: none;
  }

  .study-timeline-item:not(:last-child)::after {
    position: absolute;
    top: 2.15rem;
    left: 50%;
    z-index: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(197, 75, 50, 0.72), rgba(197, 75, 50, 0.28));
    content: '';
  }

  .study-timeline-item a {
    position: relative;
    z-index: 1;
  }

  .study-timeline-node {
    position: relative;
    z-index: 2;
    display: block;
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid var(--color-accent);
    border-radius: 9999px;
    background: white;
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.88);
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .study-timeline-item a:hover .study-timeline-node,
  .study-timeline-item a:focus-visible .study-timeline-node {
    background: var(--color-accent);
    box-shadow: 0 0 0 6px rgba(197, 75, 50, 0.12);
    transform: scale(1.12);
  }
</style>
