---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AboutGlassSurface from '../components/ui/AboutGlassSurface';
import portfolioData from '../data/portfolio.json';

const productProjects = portfolioData.projects.filter((project) => project.featured);
const productNavItems = productProjects.map((project) => ({
  label: project.title,
  href: `/product#${project.id}`,
}));
---

<BaseLayout
  title="Products | Son Danha"
  description="손단하가 현재 만들고 있는 프로덕트를 소개합니다."
>
  <Header navItems={productNavItems} />

  <main class="page-shell min-h-screen overflow-hidden pb-24 pt-28 sm:pt-36">
    <section class="relative px-6 pb-20 sm:pb-28">
      <div class="relative mx-auto max-w-6xl">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-[var(--color-accent)]">Products</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-6xl">
          지금 만들고 있는 프로덕트
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-text-secondary)] sm:text-lg">
          기획과 설계부터 실제 구현까지 참여하며 발전시키고 있는 두 개의 프로덕트입니다. 상세 내용은 진행 과정에 맞춰 계속 보강합니다.
        </p>

        <nav class="mt-10 flex flex-wrap gap-2" aria-label="프로덕트 바로가기">
          {productProjects.map((project, index) => (
            <a
              href={`#${project.id}`}
              class="glass-chip inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
            >
              <span class="text-xs text-[var(--color-accent)]">{String(index + 1).padStart(2, '0')}</span>
              {project.title}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <div class="mx-auto max-w-6xl border-t border-[var(--color-border)] px-6">
      {productProjects.map((project, index) => (
        <section
          id={project.id}
          class="grid scroll-mt-28 gap-8 border-b border-[var(--color-border)] py-16 sm:py-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16"
        >
          <div class:list={['relative', index % 2 === 1 && 'lg:order-2']}>
            {/* 글래스 카드 컨테이너 */}
            <div class="product-glass-card aspect-[4/3] overflow-hidden rounded-[1.5rem]">
              {/* LiquiGlass 레이어 */}
              <div class="product-glass-layer" aria-hidden="true">
                <AboutGlassSurface client:load className="product-glass-surface" />
              </div>

              {/* 콘텐츠: A-Voice Chat은 dh-logo + 제품명, 나머지는 썸네일 이미지 */}
              {project.id === 'mobile-ai-product' ? (
                <div class="product-logo-wrap">
                  <img
                    src="/images/projects/a-voice-chat-logo.png"
                    alt="A-Voice Chat 로고"
                    class="product-logo-img"
                    loading="eager"
                  />
                </div>
              ) : (
                <img
                  src={project.thumbnail}
                  alt={`${project.title} 프로덕트 이미지`}
                  class:list={[
                    'product-thumb',
                    project.thumbnailPosition === 'top' ? 'object-top' : 'object-center',
                  ]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              )}
            </div>
          </div>

          <div class="flex min-h-[22rem] flex-col justify-center">
            <div class="flex items-center gap-4">
              <span class="text-sm font-bold tracking-[0.18em] text-[var(--color-accent)]">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="h-px w-10 bg-[var(--color-accent)]"></span>
              <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-text-tertiary)]">
                In Progress
              </span>
            </div>

            <h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
              {project.title}
            </h2>
            <p class="mt-6 text-base leading-8 text-[var(--color-text-secondary)]">
              {project.description}
            </p>

            <ul class="mt-7 flex flex-wrap gap-2" aria-label={`${project.title} 키워드`}>
              {project.tags.map((tag) => (
                <li class="rounded-full bg-[var(--color-bg-secondary)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text-secondary)]">
                  {tag}
                </li>
              ))}
            </ul>

            <p class="mt-10 inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[var(--color-accent)]">
              <span class="h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
              상세 내용 준비 중
            </p>
          </div>
        </section>
      ))}
    </div>

    <div class="mx-auto mt-12 flex max-w-6xl px-6">
      <a href="/#projects" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-accent)]">
        <span aria-hidden="true">←</span>
        포트폴리오 프로젝트로 돌아가기
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  /* 글래스 카드 — 배경 없음, 테두리만 */
  .product-glass-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: transparent;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 20px 56px rgba(31, 48, 76, 0.1);
  }

  /* LiquiGlass 레이어 */
  .product-glass-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .product-glass-layer :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.product-glass-surface) {
    --lq-tint: rgba(247, 252, 255, 0.1);
    --lq-tint-deep: rgba(13, 27, 54, 0.03);
    --lq-rim-hi: rgba(255, 255, 255, 0.96);
    --lq-rim-lo: rgba(154, 200, 236, 0.38);
    --lq-highlight: rgba(255, 255, 255, 0.82);
    --lq-shadow: none;
    width: 100%;
    height: 100%;
  }

  /* 썸네일 이미지 — 글래스 위에 오버레이 */
  .product-thumb {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    opacity: 0.88;
  }

  /* dh 로고 + 글래스 레이아웃 */
  .product-logo-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 로고 이미지 — 검은 로고, 글래스 배경에 자연스럽게 */
  .product-logo-img {
    width: 78%;
    max-width: 320px;
    height: auto;
    opacity: 0.72;
    filter:
      drop-shadow(0 2px 12px rgba(13, 27, 54, 0.2))
      drop-shadow(0 0 4px rgba(255, 255, 255, 0.5));
  }
</style>
