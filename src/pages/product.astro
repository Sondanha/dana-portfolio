---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import portfolioData from '../data/portfolio.json';

const productProjects = portfolioData.projects.filter((project) => project.featured);
const productNavItems = productProjects.map((project) => ({
  label: project.title,
  href: `/product#${project.id}`,
}));
---

<BaseLayout
  title="Products | Son Danha"
  description="손단하가 현재 만들고 있는 프로덕트를 소개합니다."
>
  <Header navItems={productNavItems} />

  <main class="min-h-screen overflow-hidden bg-white pb-24 pt-28 sm:pt-36">
    <section class="relative px-6 pb-20 sm:pb-28">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 bg-[linear-gradient(rgba(23,36,62,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(23,36,62,0.035)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
        <div class="absolute -left-24 top-6 h-72 w-72 rounded-full border-[26px] border-[var(--color-accent)] opacity-[0.06]"></div>
        <img src="/favicon.png" alt="" class="absolute -right-20 -top-20 w-[30rem] opacity-[0.035]" width="480" height="480" />
      </div>

      <div class="relative mx-auto max-w-6xl">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-[var(--color-accent)]">Products</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-6xl">
          지금 만들고 있는 프로덕트
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-text-secondary)] sm:text-lg">
          기획과 설계부터 실제 구현까지 참여하며 발전시키고 있는 두 개의 프로덕트입니다. 상세 내용은 진행 과정에 맞춰 계속 보강합니다.
        </p>

        <nav class="mt-10 flex flex-wrap gap-2" aria-label="프로덕트 바로가기">
          {productProjects.map((project, index) => (
            <a
              href={`#${project.id}`}
              class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-white px-4 py-2 text-sm font-semibold text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
            >
              <span class="text-xs text-[var(--color-accent)]">{String(index + 1).padStart(2, '0')}</span>
              {project.title}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <div class="mx-auto max-w-6xl border-t border-[var(--color-border)] px-6">
      {productProjects.map((project, index) => (
        <section
          id={project.id}
          class="grid scroll-mt-28 gap-8 border-b border-[var(--color-border)] py-16 sm:py-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16"
        >
          <div class:list={['relative', index % 2 === 1 && 'lg:order-2']}>
            <div class:list={[
              'aspect-[4/3] overflow-hidden rounded-xl shadow-[0_18px_55px_rgba(23,36,62,0.08)]',
              project.id === 'mobile-ai-product' ? 'bg-black' : 'bg-[var(--color-bg-secondary)]',
            ]}>
              <img
                src={project.thumbnail}
                alt={`${project.title} 프로덕트 이미지`}
                class:list={[
                  'h-full w-full',
                  project.id === 'mobile-ai-product' ? 'object-contain' : 'object-cover',
                  project.thumbnailPosition === 'top' ? 'object-top' : 'object-center',
                ]}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>
          </div>

          <div class="flex min-h-[22rem] flex-col justify-center">
            <div class="flex items-center gap-4">
              <span class="text-sm font-bold tracking-[0.18em] text-[var(--color-accent)]">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="h-px w-10 bg-[var(--color-accent)]"></span>
              <span class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-text-tertiary)]">
                In Progress
              </span>
            </div>

            <h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
              {project.title}
            </h2>
            <p class="mt-6 text-base leading-8 text-[var(--color-text-secondary)]">
              {project.description}
            </p>

            <ul class="mt-7 flex flex-wrap gap-2" aria-label={`${project.title} 키워드`}>
              {project.tags.map((tag) => (
                <li class="rounded-full bg-[var(--color-bg-secondary)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text-secondary)]">
                  {tag}
                </li>
              ))}
            </ul>

            <p class="mt-10 inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[var(--color-accent)]">
              <span class="h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
              상세 내용 준비 중
            </p>
          </div>
        </section>
      ))}
    </div>

    <div class="mx-auto mt-12 flex max-w-6xl px-6">
      <a href="/#projects" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-accent)]">
        <span aria-hidden="true">←</span>
        포트폴리오 프로젝트로 돌아가기
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
</style>
