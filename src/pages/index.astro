---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AboutFlowSection from '../components/sections/AboutFlowSection.astro';
import ProductShowcaseSection from '../components/sections/ProductShowcaseSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import TimelineSection from '../components/sections/TimelineSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<BaseLayout>
  <Header enableMegaMenu />

  <main>
    <HeroSection />
    <AboutFlowSection />
    <ProductShowcaseSection />
    <SkillsSection />
    <TimelineSection />
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
