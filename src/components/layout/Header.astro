---
import LiquidNavGlass from '../ui/LiquidNavGlass';
import { LiquidContactButton } from '../ui/LiquidHeroGlass';

interface NavItem {
  readonly label: string;
  readonly href: string;
}

interface Props {
  readonly navItems?: readonly NavItem[];
  readonly enableMegaMenu?: boolean;
}

const defaultNavItems = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Timeline', href: '/#timeline' },
] as const;

const { navItems = defaultNavItems, enableMegaMenu = false } = Astro.props;
const hasNavigation = navItems.length > 0;

const pathname = Astro.url.pathname;
const isProjectPage = pathname.startsWith('/product') || pathname.startsWith('/study');
const contactLabel = isProjectPage ? 'Home' : 'Contact Me';
const contactHref = isProjectPage ? '/' : '/contact';

const megaNavGroups = [
  {
    label: 'About',
    items: [],
  },
  {
    label: 'Projects',
    items: [
      { label: 'Product', href: '/product' },
      { label: 'Study Projects', href: '/study' },
    ],
  },
  {
    label: 'Skills',
    items: [
      { label: 'AI Engineering', href: '/#skills' },
      { label: 'Full-stack', href: '/#skills' },
      { label: 'Team Execution', href: '/#skills' },
      { label: 'Data & Cloud', href: '/#skills' },
    ],
  },
  {
    label: 'Timeline',
    items: [
      { label: 'Activity', href: '/?timeline=activity#timeline' },
      { label: 'Education', href: '/?timeline=education#timeline' },
      { label: 'Achievement', href: '/?timeline=achievement#timeline' },
    ],
  },
] as const;
---

<header
  class="fixed top-0 left-0 right-0 z-50 px-3 transition-all duration-300 sm:px-4"
  id="site-header"
>
  <div class="header-refraction-stage" aria-hidden="true">
    <LiquidNavGlass client:load />
  </div>

  <nav class="header-nav-shell mx-auto mt-0 flex min-h-[4.5rem] max-w-7xl items-center border border-transparent px-4 py-3 transition-all duration-300 sm:px-6">
    <a
      href="/"
      id="header-logo-link"
      class="header-logo-link inline-flex shrink-0 items-center transition-transform hover:scale-105"
      aria-label="홈으로 이동 (모바일 메뉴 열기)"
    >
      <img src="/dh-logo.svg" alt="" class="h-12 w-12 object-contain" width="48" height="48" />
    </a>

    <!-- Mobile Close X Shape (Only visible when opened) -->
    <svg 
      id="mobile-close-shape" 
      class="mobile-close-shape md:hidden" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
    </svg>

    <!-- Desktop Nav -->
    {hasNavigation && (
      <ul class="ml-10 hidden items-center gap-8 md:flex">
        {navItems.map((item) => (
          <li class:list={['desktop-nav-item', enableMegaMenu && 'has-mega-menu']}>
            <a
              href={item.href}
              class="inline-flex items-center gap-1.5 text-base font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
              aria-haspopup={enableMegaMenu ? 'true' : undefined}
            >
              {item.label}
            </a>

          </li>
        ))}
      </ul>
    )}

    <div class="ml-auto hidden md:block">
      <LiquidContactButton compact icon="none" client:load label={contactLabel} href={contactHref} />
    </div>

    <!-- Mobile Menu Button removed, logo is the toggle -->
  </nav>

  {enableMegaMenu && (
    <div class="project-menu-extension mx-auto hidden max-w-7xl md:block">
      <div class="grid grid-cols-4">
        {megaNavGroups.map((group, index) => (
          <section class:list={['min-h-56 px-8 py-7', index > 0 && 'border-l border-[var(--color-border)]']}>
            <h2 class="text-sm font-medium text-[var(--color-text-primary)]">{group.label}</h2>
            <div class="mt-5 flex flex-col items-start gap-3">
              {group.items.map((menuItem) => (
                <a href={menuItem.href} class="project-menu-link inline-flex items-center gap-2 text-base font-normal text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]">
                  <span>{menuItem.label}</span>
                  <span class="project-menu-link-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  )}

  <!-- Mobile Menu -->
  {hasNavigation && (
    <div
      id="mobile-menu"
      class="mobile-menu-extension mx-auto max-w-7xl md:hidden"
    >
      <ul class="flex flex-col px-6 py-4">
        {enableMegaMenu ? megaNavGroups.map((group, index) => (
          <li class:list={['py-3', index !== megaNavGroups.length - 1 && 'border-b border-[var(--color-border)]']}>
            <a
              href={navItems.find((item) => item.label === group.label)?.href || '/'}
              class="mobile-nav-link block text-sm font-medium text-[var(--color-text-primary)]"
            >
              {group.label}
            </a>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
              {group.items.map((menuItem) => (
                <a href={menuItem.href} class="mobile-nav-link text-sm font-normal text-[var(--color-accent)]">
                  {menuItem.label}
                </a>
              ))}
            </div>
          </li>
        )) : navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link block py-3 text-base font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <div class="mt-3">
            <LiquidContactButton fullWidth icon="none" client:load label={contactLabel} href={contactHref} />
          </div>
        </li>
      </ul>
    </div>
  )}
</header>

<script>
  const header = document.getElementById('site-header');
  const logoLink = document.getElementById('header-logo-link');
  const mobileCloseShape = document.getElementById('mobile-close-shape');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll effect: turn the navigation into a floating white card.
  function handleScroll(): void {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 20);
  }

  // Mobile menu toggle
  function toggleMobileMenu(): void {
    const isNowOpen = !header?.classList.contains('is-mobile-open');
    header?.classList.toggle('is-mobile-open', isNowOpen);
    logoLink?.setAttribute('aria-expanded', String(isNowOpen));

    const refractionStage = header?.querySelector('.header-refraction-stage') as HTMLElement;
    if (isNowOpen && refractionStage && header && mobileMenu) {
      const navShell = header.querySelector('.header-nav-shell') as HTMLElement;
      // We must measure the inner UL since the container might be animating its max-height
      const menuContent = mobileMenu.querySelector('ul') as HTMLElement;
      const totalHeight = navShell.offsetHeight + (menuContent ? menuContent.offsetHeight : 0) + 16;
      refractionStage.style.height = `${totalHeight}px`;
    } else if (refractionStage) {
      refractionStage.style.height = '';
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
  
  logoLink?.addEventListener('click', (e) => {
    if (window.innerWidth < 768) {
      e.preventDefault();
      toggleMobileMenu();
    }
  });

  mobileCloseShape?.addEventListener('click', () => {
    if (window.innerWidth < 768) {
      toggleMobileMenu();
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      logoLink?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-mobile-open');
      const refractionStage = header?.querySelector('.header-refraction-stage') as HTMLElement;
      if (refractionStage) {
        refractionStage.style.height = '';
      }
    });
  });
</script>

<style>
  @keyframes float-logo {
    0%, 100% { transform: translateY(-50%); }
    50% { transform: translateY(calc(-50% - 4px)); }
  }

  @media (max-width: 767px) {
    .header-logo-link {
      position: absolute;
      top: 50%;
      right: 1rem;
      transform: translateY(-50%);
      /* Remove default transition from inline class to control it fully */
      transition: right 300ms var(--ease-out-expo), transform 300ms var(--ease-out-expo) !important;
      animation: float-logo 4s ease-in-out infinite;
    }

    #site-header.is-mobile-open .header-logo-link {
      /* Width of container is 100%, we want it on the left padding (1rem) */
      right: calc(100% - 1rem - 3rem); /* 100% - right_padding - logo_width */
      /* Stop floating when menu is open for stability */
      animation: none;
      transform: translateY(-50%);
    }

    .mobile-close-shape {
      position: absolute;
      right: 1.75rem; /* Perfectly centers X horizontally where the logo used to be */
      top: 50%;
      transform: translateY(-50%) rotate(-90deg) scale(0.5);
      width: 1.5rem;
      height: 1.5rem;
      color: var(--color-text-secondary);
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      /* Fast fade out when closing */
      transition: all 200ms ease;
    }

    #site-header.is-mobile-open .mobile-close-shape {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(-50%) rotate(0deg) scale(1);
      /* Delay fade in so it appears after the bubble expands */
      transition: all 400ms var(--ease-out-expo) 300ms;
    }
  }

  .mobile-menu-extension {
    position: relative;
    z-index: 2;
    margin-top: 0;
    max-height: 0;
    overflow: visible;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* Close: content disappears and shrinks height instantly, while glass width waits */
    transition: max-height 300ms var(--ease-out-expo), opacity 150ms ease, visibility 150ms ease;
  }

  #site-header.is-mobile-open .mobile-menu-extension {
    max-height: 40rem; /* Enough to fit the menu */
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    /* Open: content waits 300ms for width to expand before dropping down and fading in */
    transition: max-height 300ms var(--ease-out-expo) 300ms, opacity 250ms ease 400ms, visibility 0ms 300ms;
  }

  .desktop-nav-item {
    position: relative;
  }

  .has-mega-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 1.75rem;
  }

  .project-menu-extension {
    position: relative;
    z-index: 2;
    margin-top: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    border: 0;
    border-radius: 0 0 36px 36px;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: max-height 360ms var(--ease-out-expo), opacity 180ms ease, visibility 180ms ease;
  }

  .project-menu-link-arrow {
    opacity: 0;
    transform: translateX(-0.35rem);
    transition: opacity 160ms ease, transform 220ms var(--ease-out-expo);
  }

  .project-menu-link:hover .project-menu-link-arrow,
  .project-menu-link:focus-visible .project-menu-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  #site-header:has(.has-mega-menu:hover) .project-menu-extension,
  #site-header:has(.has-mega-menu:focus-within) .project-menu-extension,
  .project-menu-extension:hover,
  .project-menu-extension:focus-within {
    max-height: 14rem;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #site-header:has(.has-mega-menu:hover) .header-nav-shell,
  #site-header:has(.has-mega-menu:focus-within) .header-nav-shell,
  #site-header:has(.project-menu-extension:hover) .header-nav-shell,
  #site-header:has(.project-menu-extension:focus-within) .header-nav-shell,
  #site-header.is-mobile-open .header-nav-shell {
    border-radius: 36px;
  }
</style>
