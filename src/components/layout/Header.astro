---
import LiquidNavGlass from '../ui/LiquidNavGlass';
import { LiquidContactButton } from '../ui/LiquidHeroGlass';

interface NavItem {
  readonly label: string;
  readonly href: string;
}

interface Props {
  readonly navItems?: readonly NavItem[];
  readonly enableMegaMenu?: boolean;
}

const defaultNavItems = [
  { label: 'About', href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Timeline', href: '/#timeline' },
] as const;

const { navItems = defaultNavItems, enableMegaMenu = false } = Astro.props;
const hasNavigation = navItems.length > 0;

const megaNavGroups = [
  {
    label: 'About',
    items: [],
  },
  {
    label: 'Projects',
    items: [
      { label: 'Product', href: '/product' },
      { label: 'Study Projects', href: '/study' },
    ],
  },
  {
    label: 'Skills',
    items: [
      { label: 'AI Engineering', href: '/?skill=ai-model#skills' },
      { label: 'Full-stack', href: '/?skill=full-stack#skills' },
      { label: 'Team Execution', href: '/?skill=team#skills' },
      { label: 'Data & Cloud', href: '/?skill=data-cloud#skills' },
    ],
  },
  {
    label: 'Timeline',
    items: [
      { label: 'Activity', href: '/?timeline=activity#timeline' },
      { label: 'Education', href: '/?timeline=education#timeline' },
      { label: 'Achievement', href: '/?timeline=achievement#timeline' },
    ],
  },
] as const;
---

<header
  class="fixed top-0 left-0 right-0 z-50 px-3 transition-all duration-300 sm:px-4"
  id="site-header"
>
  <div class="header-refraction-stage" aria-hidden="true">
    <LiquidNavGlass client:load />
  </div>

  <nav class="header-nav-shell mx-auto mt-0 flex max-w-7xl items-center border border-transparent px-4 py-3 transition-all duration-300 sm:px-6">
    <a
      href="/"
      class="inline-flex shrink-0 items-center transition-transform hover:scale-105"
      aria-label="홈으로 이동"
    >
      <img src="/dh-logo.svg" alt="" class="h-12 w-12 object-contain" width="48" height="48" />
    </a>

    <!-- Desktop Nav -->
    {hasNavigation && (
      <ul class="ml-10 hidden items-center gap-8 md:flex">
        {navItems.map((item) => (
          <li class:list={['desktop-nav-item', enableMegaMenu && 'has-mega-menu']}>
            <a
              href={item.href}
              class="inline-flex items-center gap-1.5 text-base font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
              aria-haspopup={enableMegaMenu ? 'true' : undefined}
            >
              {item.label}
            </a>

          </li>
        ))}
      </ul>
    )}

    <div class="ml-auto hidden md:block">
      <LiquidContactButton compact icon="none" client:load />
    </div>

    <!-- Mobile Menu Button -->
    {hasNavigation && (
      <button
        id="mobile-menu-toggle"
        class="ml-auto flex h-10 w-10 items-center justify-center rounded-full text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-bg-card)] md:hidden"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    )}
  </nav>

  {enableMegaMenu && (
    <div class="project-menu-extension mx-auto hidden max-w-7xl md:block">
      <div class="grid grid-cols-4">
        {megaNavGroups.map((group, index) => (
          <section class:list={['min-h-56 px-8 py-7', index > 0 && 'border-l border-[var(--color-border)]']}>
            <h2 class="text-sm font-medium text-[var(--color-text-primary)]">{group.label}</h2>
            <div class="mt-5 flex flex-col items-start gap-3">
              {group.items.map((menuItem) => (
                <a href={menuItem.href} class="project-menu-link inline-flex items-center gap-2 text-base font-normal text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]">
                  <span>{menuItem.label}</span>
                  <span class="project-menu-link-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  )}

  <!-- Mobile Menu -->
  {hasNavigation && (
    <div
      id="mobile-menu"
      class="mx-auto mt-2 hidden max-w-7xl overflow-hidden rounded-[36px] border border-white/75 bg-white/70 shadow-[inset_0_1px_0_white,0_18px_48px_rgba(47,65,91,0.14)] backdrop-blur-2xl md:hidden"
    >
      <ul class="flex flex-col px-6 py-4">
        {enableMegaMenu ? megaNavGroups.map((group) => (
          <li class="border-b border-[var(--color-border)] py-3 last:border-0">
            <a
              href={navItems.find((item) => item.label === group.label)?.href || '/'}
              class="mobile-nav-link block text-sm font-medium text-[var(--color-text-primary)]"
            >
              {group.label}
            </a>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
              {group.items.map((menuItem) => (
                <a href={menuItem.href} class="mobile-nav-link text-sm font-normal text-[var(--color-accent)]">
                  {menuItem.label}
                </a>
              ))}
            </div>
          </li>
        )) : navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link block py-3 text-base font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <div class="mt-3">
            <LiquidContactButton fullWidth icon="none" client:load />
          </div>
        </li>
      </ul>
    </div>
  )}
</header>

<script>
  const header = document.getElementById('site-header');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll effect: turn the navigation into a floating white card.
  function handleScroll(): void {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 20);
  }

  // Mobile menu toggle
  function toggleMobileMenu(): void {
    mobileMenu?.classList.toggle('hidden');
    mobileToggle?.setAttribute('aria-expanded', String(!mobileMenu?.classList.contains('hidden')));
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
  mobileToggle?.addEventListener('click', toggleMobileMenu);

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .desktop-nav-item {
    position: relative;
  }

  .has-mega-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 1.75rem;
  }

  .project-menu-extension {
    position: relative;
    z-index: 2;
    margin-top: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    border: 0;
    border-radius: 0 0 36px 36px;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: max-height 360ms var(--ease-out-expo), opacity 180ms ease, visibility 180ms ease;
  }

  .project-menu-link-arrow {
    opacity: 0;
    transform: translateX(-0.35rem);
    transition: opacity 160ms ease, transform 220ms var(--ease-out-expo);
  }

  .project-menu-link:hover .project-menu-link-arrow,
  .project-menu-link:focus-visible .project-menu-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  #site-header:has(.has-mega-menu:hover) .project-menu-extension,
  #site-header:has(.has-mega-menu:focus-within) .project-menu-extension,
  .project-menu-extension:hover,
  .project-menu-extension:focus-within {
    max-height: 14rem;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #site-header:has(.has-mega-menu:hover) .header-nav-shell,
  #site-header:has(.has-mega-menu:focus-within) .header-nav-shell,
  #site-header:has(.project-menu-extension:hover) .header-nav-shell,
  #site-header:has(.project-menu-extension:focus-within) .header-nav-shell {
    border-radius: 36px;
  }
</style>
