---
import portfolioData from '../../data/portfolio.json';

const navItems = [
  { label: 'Now', href: '#now' },
  { label: 'Projects', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Timeline', href: '#timeline' },
  { label: 'Contact', href: '#contact' },
] as const;

const { meta } = portfolioData;
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-300"
  id="site-header"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-[var(--color-text-primary)] transition-colors hover:text-[var(--color-accent)]"
    >
      {meta.name}
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-bg-card)] md:hidden"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-[var(--color-border)] bg-[var(--color-bg-primary)]/95 backdrop-blur-xl md:hidden"
  >
    <ul class="flex flex-col px-6 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="mobile-nav-link block py-3 text-base font-medium text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll effect: add background on scroll
  function handleScroll(): void {
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add('bg-[var(--color-bg-primary)]/80', 'backdrop-blur-xl', 'border-[var(--color-border)]');
      header.classList.remove('border-transparent');
    } else {
      header.classList.remove('bg-[var(--color-bg-primary)]/80', 'backdrop-blur-xl', 'border-[var(--color-border)]');
      header.classList.add('border-transparent');
    }
  }

  // Mobile menu toggle
  function toggleMobileMenu(): void {
    mobileMenu?.classList.toggle('hidden');
    mobileToggle?.setAttribute('aria-expanded', String(!mobileMenu?.classList.contains('hidden')));
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  mobileToggle?.addEventListener('click', toggleMobileMenu);

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
