---
import portfolioData from '../../data/portfolio.json';

const { hero } = portfolioData;
---

<section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden px-6" id="hero">
  <!-- Soft atmosphere derived from the DH monogram palette -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-x-0 top-0 h-[72%] bg-[radial-gradient(circle_at_50%_12%,rgba(242,184,75,0.20),transparent_56%)]"></div>
    <div class="absolute -right-24 top-24 h-72 w-72 rounded-full bg-[var(--color-brand-coral)] opacity-10 blur-[100px]"></div>
    <div class="absolute -left-28 top-44 h-64 w-64 rounded-full bg-[var(--color-brand-navy)] opacity-[0.07] blur-[110px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl text-center">
    <p class="mb-7 text-xs font-bold uppercase tracking-[0.24em] text-[var(--color-accent)] sm:text-sm">
      {hero.tagline.replace(' & ', ' · ')}
    </p>

    <!-- Main headline -->
    <h1 class="mb-6 text-5xl font-extrabold leading-[1.1] tracking-tight text-[var(--color-text-primary)] sm:text-6xl md:text-7xl lg:text-8xl">
      {hero.headline}
    </h1>

    <!-- Subheadline -->
    {hero.subheadline && (
      <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-[var(--color-text-secondary)] sm:text-xl">
        {hero.subheadline.split('\n').map((line: string, i: number) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    )}

    <!-- CTA -->
    <div class="flex items-center justify-center gap-4">
      <a
        href={hero.cta.href}
        class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-brand-navy)] px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_24px_rgba(23,36,62,0.18)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[var(--color-accent)] hover:shadow-[0_12px_30px_rgba(232,93,63,0.24)]"
      >
        {hero.cta.label}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
    <div class="flex h-8 w-5 items-start justify-center rounded-full border border-[var(--color-border)] p-1">
      <div class="h-2 w-1 animate-bounce rounded-full bg-[var(--color-accent)]"></div>
    </div>
  </div>
</section>
