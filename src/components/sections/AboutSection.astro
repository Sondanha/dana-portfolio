---
import portfolioData from '../../data/portfolio.json';
import AboutGlassSurface from '../ui/AboutGlassSurface';

const { about, meta } = portfolioData;
---

<section class="px-6 py-[var(--spacing-section)]" id="about">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">{about.eyebrow}</p>
        <h2 class="whitespace-pre-line text-3xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-4xl lg:text-5xl">
          {about.headline.split(/(기획|개발)/).map((part) =>
            part === '기획' || part === '개발'
              ? <span class="text-[var(--color-accent)]">{part}</span>
              : part
          )}
        </h2>
        <p class="mt-7 max-w-md text-base leading-relaxed text-[var(--color-text-secondary)] sm:text-lg">
          {about.description}
        </p>
        <a
          href={meta.velog}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]"
        >
          Velog에서 더 긴 생각 보기
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      </div>

      <div class="about-values-wrap relative">
        <div class="about-refraction-stage" aria-hidden="true">
          <AboutGlassSurface client:load />
        </div>
        <ol class="about-values-grid relative z-10 grid h-full overflow-clip rounded-[36px] sm:grid-cols-2" data-about-grid>
          {about.values.map((value, index) => (
            <li class="about-value-slot relative min-h-36 sm:min-h-64">
              <article class="about-value-card" tabindex="0" data-about-card>
                <div class="card-glass-layer" aria-hidden="true">
                  <AboutGlassSurface client:load className="card-glass-surface" />
                </div>
                <span class="card-index-badge" aria-hidden="true">0{index + 1}</span>
                <h3 class="card-content text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">{value.title}</h3>
                <p class="card-content about-value-description mt-6 text-base font-semibold leading-relaxed text-[var(--color-text-primary)]">{value.description}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  const aboutCards = document.querySelectorAll<HTMLElement>('[data-about-card]');
  const aboutGrid = document.querySelector<HTMLElement>('[data-about-grid]');
  const desktopGrid = window.matchMedia('(min-width: 640px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const aboutSection = document.querySelector<HTMLElement>('#about');
  let autoPlayTimer: number | undefined;
  let autoPlayResumeTimer: number | undefined;
  let autoPlayIndex = 0;
  let isAboutVisible = false;

  const EXPAND_DURATION_MS = 900;

  const showBaseGrid = (): void => {
    aboutCards.forEach((card) => {
      if (card.classList.contains('is-expanded')) {
        card.classList.add('is-collapsing');
        card.classList.remove('content-visible', 'is-auto-expanded', 'is-expanded');
        window.setTimeout(() => {
          aboutGrid?.classList.remove('has-expanded-card');
        }, 150);
        window.setTimeout(() => {
          card.classList.remove('is-collapsing');
        }, EXPAND_DURATION_MS + 100);
      } else {
        aboutGrid?.classList.remove('has-expanded-card');
        card.classList.remove('is-auto-expanded', 'is-expanded', 'content-visible');
      }
    });
  };

  let contentVisibleTimer: number | undefined;

  const expandCard = (card: HTMLElement): void => {
    card.classList.add('is-expanded', 'is-auto-expanded');
    aboutGrid?.classList.add('has-expanded-card');
    if (contentVisibleTimer) window.clearTimeout(contentVisibleTimer);
    contentVisibleTimer = window.setTimeout(() => {
      card.classList.add('content-visible');
    }, EXPAND_DURATION_MS);
  };

  const stopAutoPlay = (): void => {
    if (autoPlayTimer) window.clearTimeout(autoPlayTimer);
    if (autoPlayResumeTimer) window.clearTimeout(autoPlayResumeTimer);
    if (contentVisibleTimer) window.clearTimeout(contentVisibleTimer);
    autoPlayTimer = undefined;
    autoPlayResumeTimer = undefined;
    contentVisibleTimer = undefined;
    showBaseGrid();
  };

  const playNextAutomaticCard = (): void => {
    if (!desktopGrid.matches || reducedMotion.matches || !isAboutVisible || aboutCards.length === 0) return;

    showBaseGrid();
    const card = aboutCards[autoPlayIndex % aboutCards.length];
    expandCard(card);
    autoPlayIndex = (autoPlayIndex + 1) % aboutCards.length;

    autoPlayTimer = window.setTimeout(() => {
      showBaseGrid();
      autoPlayTimer = window.setTimeout(playNextAutomaticCard, 3600);
    }, 6400);
  };

  const startAutoPlay = (): void => {
    stopAutoPlay();
    if (!desktopGrid.matches || reducedMotion.matches || !isAboutVisible) return;

    playNextAutomaticCard();
  };

  const resumeAutoPlay = (): void => {
    if (autoPlayResumeTimer) window.clearTimeout(autoPlayResumeTimer);
    autoPlayResumeTimer = window.setTimeout(startAutoPlay, 700);
  };

  aboutGrid?.addEventListener('pointerenter', stopAutoPlay);
  aboutGrid?.addEventListener('pointerleave', resumeAutoPlay);
  aboutGrid?.addEventListener('focusin', stopAutoPlay);
  aboutGrid?.addEventListener('focusout', () => {
    window.setTimeout(() => {
      if (!aboutGrid.matches(':hover') && !aboutGrid.contains(document.activeElement)) resumeAutoPlay();
    });
  });

  desktopGrid.addEventListener('change', startAutoPlay);
  reducedMotion.addEventListener('change', startAutoPlay);

  if (aboutSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      isAboutVisible = entry.isIntersecting;
      if (isAboutVisible) startAutoPlay();
      else stopAutoPlay();
    }, { threshold: 0.2 });
    observer.observe(aboutSection);
  } else {
    isAboutVisible = true;
    startAutoPlay();
  }
</script>

<style>
  .about-values-grid {
    grid-auto-rows: 1fr;
    background: transparent;
  }

  .about-refraction-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 36px;
    pointer-events: none;
  }

  .about-refraction-stage :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.about-refraction-surface) {
    --lq-tint: rgba(247, 252, 255, 0.08);
    --lq-tint-deep: rgba(13, 27, 54, 0.025);
    --lq-rim-hi: rgba(255, 255, 255, 0.96);
    --lq-rim-lo: rgba(154, 200, 236, 0.34);
    --lq-highlight: rgba(255, 255, 255, 0.78);
    --lq-shadow: 0 24px 64px rgba(31, 48, 76, 0.12), 0 3px 10px rgba(184, 95, 115, 0.08);
    width: 100%;
    height: 100%;
  }

  /* 확대 카드 내부 글래스 레이어 */
  .card-glass-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .card-glass-layer :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.card-glass-surface) {
    --lq-tint: rgba(247, 252, 255, 0.12);
    --lq-tint-deep: rgba(13, 27, 54, 0.04);
    --lq-rim-hi: rgba(255, 255, 255, 0.98);
    --lq-rim-lo: rgba(154, 200, 236, 0.42);
    --lq-highlight: rgba(255, 255, 255, 0.88);
    --lq-shadow: none;
    width: 100%;
    height: 100%;
  }

  /* 카드 내 텍스트 — 기본 표시 상태 */
  .card-content {
    position: relative;
    z-index: 1;
    display: block;
    opacity: 1;
    transition: opacity 200ms ease;
  }

  /* 숫자 배지 — 카드(position:absolute) 기준 우측 상단 */
  .card-index-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.75rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text-secondary);
    line-height: 1;
    opacity: 1;
    transition: opacity 200ms ease;
  }

  .about-values-wrap {
    isolation: isolate;
  }

  .about-value-slot {
    transition: none;
  }

  .about-values-grid.has-expanded-card .about-value-card:not(.is-expanded) {
    opacity: 0;
  }

  .about-value-card {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.32);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 1px 0 0 rgba(255, 255, 255, 0.08);
    padding: 2rem;
    transition:
      left 900ms cubic-bezier(0.22, 1, 0.36, 1),
      top 900ms cubic-bezier(0.22, 1, 0.36, 1),
      width 900ms cubic-bezier(0.22, 1, 0.36, 1),
      height 900ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 500ms ease,
      box-shadow 650ms ease,
      background 650ms ease,
      opacity 650ms ease,
      overflow 0ms 900ms;
  }

  .about-value-slot:nth-child(1) .about-value-card {
    border-top-left-radius: 36px;
  }

  .about-value-slot:nth-child(2) .about-value-card {
    border-top-right-radius: 36px;
  }

  .about-value-slot:nth-child(3) .about-value-card {
    border-bottom-left-radius: 36px;
  }

  .about-value-slot:nth-child(4) .about-value-card {
    border-bottom-right-radius: 36px;
  }

  .about-value-card::after {
    position: absolute;
    right: 2rem;
    bottom: 1.25rem;
    left: 2rem;
    height: 2px;
    background: linear-gradient(90deg, var(--color-brand-navy), var(--color-brand-coral));
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 2;
  }

  .about-value-card.is-hovered {
    z-index: 5;
    border-color: rgba(255, 255, 255, 0.76);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.105), rgba(255, 255, 255, 0.035));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 18px 44px rgba(31, 48, 76, 0.1);
  }

  .about-value-card.is-hovered::after {
    opacity: 1;
    animation: about-hover-progress 500ms linear forwards;
  }

  /* 확장 시작: 텍스트 즉시 숨김 (애니메이션 중) */
  .about-value-card.is-expanded:not(.content-visible) .card-content,
  .about-value-card.is-expanded:not(.content-visible) .card-index-badge {
    opacity: 0;
    transition: none;
  }

  /* 축소 중: is-collapsing으로 텍스트 숨김 유지 */
  .about-value-card.is-collapsing .card-content,
  .about-value-card.is-collapsing .card-index-badge {
    opacity: 0;
    transition: none;
  }

  /* 확장 완료(content-visible) 후: flex 가운데 정렬로 텍스트 표시 */
  .about-value-card.is-expanded.content-visible {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .about-value-card.is-expanded.content-visible .card-content {
    opacity: 1;
    transition: opacity 350ms ease;
  }

  /* 확장 완료 시 서브 제목 크기 확대 */
  .about-value-card.is-expanded.content-visible h3 {
    font-size: 1.25rem;
    letter-spacing: 0.18em;
    margin-bottom: 0.5rem;
  }

  /* 확장 완료 후 숫자 배지는 숨김 유지 (레이아웃 방해 방지) */
  .about-value-card.is-expanded.content-visible .card-index-badge {
    opacity: 0;
  }

  /* 확장 완료 상태 카드 스타일 */
  .about-value-card.is-expanded {
    z-index: 20;
    overflow: visible;
    border-color: rgba(255, 255, 255, 0.72);
    border-radius: 36px;
    background: transparent;
    box-shadow: 0 24px 65px rgba(31, 48, 76, 0.14);
    transition:
      left 900ms cubic-bezier(0.22, 1, 0.36, 1),
      top 900ms cubic-bezier(0.22, 1, 0.36, 1),
      width 900ms cubic-bezier(0.22, 1, 0.36, 1),
      height 900ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 500ms ease,
      box-shadow 650ms ease,
      background 650ms ease,
      opacity 650ms ease;
  }

  .about-value-card.is-expanded .card-glass-layer {
    opacity: 1;
  }

  .about-value-card.is-expanded::after {
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .about-value-description {
    transition: font-size 700ms ease, line-height 700ms ease;
  }

  @keyframes about-hover-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (min-width: 640px) {
    /*
     * 확장 카드는 슬롯의 200%가 아니라 그리드의 100%를 정확히 덮어야 함.
     * 슬롯은 그리드의 50% 너비이므로:
     *   width: 200% = 슬롯 200% = 그리드 100%  ✓
     *   height: 200% = 슬롯 200% = 그리드 100% ✓
     * 오른쪽/하단 슬롯에서의 위치 보정도 동일 비율로 적용.
     */
    .about-value-card.is-expanded {
      width: 200%;
      height: 200%;
    }

    /* 오른쪽 열 슬롯(2, 4)은 왼쪽으로 슬롯 너비(=그리드 50%)만큼 이동 */
    .about-value-slot:nth-child(2) .about-value-card.is-expanded,
    .about-value-slot:nth-child(4) .about-value-card.is-expanded {
      left: -100%;
    }

    /* 하단 행 슬롯(3, 4)은 위로 슬롯 높이만큼 이동 */
    .about-value-slot:nth-child(3) .about-value-card.is-expanded,
    .about-value-slot:nth-child(4) .about-value-card.is-expanded {
      top: -100%;
    }

    .about-value-card.is-expanded .about-value-description {
      font-size: 1.125rem;
      line-height: 1.8;
    }
  }

  @media (max-width: 639px) {
    .about-value-slot:not(:last-child) {
      border-bottom-width: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-value-card,
    .about-value-description {
      transition: none;
    }
  }

</style>
