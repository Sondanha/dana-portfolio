---
import portfolioData from '../../data/portfolio.json';

const { contact, meta } = portfolioData;
---

<section class="px-6 py-[var(--spacing-section)]" id="contact">
  <div class="mx-auto max-w-6xl">
    <div class="relative overflow-hidden rounded-xl bg-[var(--color-brand-navy)] px-7 py-14 shadow-[0_24px_70px_rgba(23,36,62,0.24)] sm:px-12 sm:py-16 lg:px-16">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_15%,rgba(242,184,75,0.36),transparent_30%),radial-gradient(circle_at_5%_100%,rgba(232,93,63,0.34),transparent_38%)]"></div>

      <div class="relative max-w-3xl">
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.22em] text-white/70">{contact.eyebrow}</p>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {contact.headline}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/80 sm:text-lg">{contact.description}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={`mailto:${meta.email}`}
            class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-bold text-[var(--color-accent)] shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            {contact.emailLabel}
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>

        </div>
      </div>
    </div>
  </div>
</section>
