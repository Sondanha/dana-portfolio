---
import portfolioData from '../../data/portfolio.json';
import { LiquidContactButton } from '../ui/LiquidHeroGlass';

const { contact } = portfolioData;
---

<section class="px-6 py-24 sm:py-28" id="contact">
  <div class="liquid-panel relative z-10 mx-auto grid max-w-6xl gap-10 overflow-hidden rounded-[22px] px-7 py-12 sm:px-12 lg:grid-cols-2 lg:grid-rows-[auto_auto] lg:gap-x-24 lg:gap-y-8 lg:px-16 lg:py-16">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-accent)]">{contact.eyebrow}</p>
      <h2 class="mt-5 max-w-lg text-3xl font-bold leading-tight tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
        함께 나누고 싶은<br />이야기가 있나요?
      </h2>
    </div>

    <div class="flex items-center lg:row-span-2">
      <p class="max-w-xl text-base font-normal leading-relaxed text-[var(--color-text-secondary)] sm:text-lg sm:leading-relaxed">
        {contact.description}
      </p>
    </div>

    <div class="lg:col-start-1 lg:row-start-2">
      <LiquidContactButton icon="arrow" client:load />
    </div>
  </div>
</section>
