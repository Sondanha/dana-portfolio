---
import portfolioData from '../../data/portfolio.json';
import AnimatedTimeline from '../ui/AnimatedTimeline';

const { timeline } = portfolioData;
---

<section class="px-6 py-[var(--spacing-section)]" id="timeline">
  <div class="mx-auto max-w-6xl">
    <!-- Section label -->
    <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">Timeline</p>
    <h2 class="mb-12 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
      지나온 길
    </h2>

    <AnimatedTimeline client:visible={{ rootMargin: '100px' }} items={timeline} />
  </div>
</section>
