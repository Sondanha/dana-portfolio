---
import portfolioData from '../../data/portfolio.json';

const { now } = portfolioData;
---

<section class="px-6 py-[var(--spacing-section)]" id="now">
  <div class="mx-auto max-w-6xl">
    <!-- Section label -->
    <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">Now</p>
    <h2 class="mb-12 text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
      지금 하고 있는 일
    </h2>

    <!-- Now Card -->
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-8 shadow-[0_12px_40px_rgba(42,39,94,0.06)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-border-hover)] hover:shadow-[0_18px_50px_rgba(42,39,94,0.1)] sm:p-10">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <!-- Role Info -->
        <div class="flex-1">
          <div class="mb-3 inline-flex items-center gap-2 rounded-md bg-[var(--color-accent-subtle)] px-3 py-1">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
            <span class="text-xs font-semibold text-[var(--color-accent)]">{now.status}</span>
          </div>
          <h3 class="mb-4 text-xl font-bold text-[var(--color-text-primary)] sm:text-2xl">
            {now.role}
          </h3>
          <ul class="space-y-3">
            {now.highlights.map((highlight) => (
              <li class="flex items-start gap-3 text-[var(--color-text-secondary)]">
                <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-text-tertiary)]"></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Visual accent -->
        <div class="hidden h-32 w-px bg-gradient-to-b from-transparent via-[var(--color-border)] to-transparent sm:block"></div>

        <!-- Quick stat -->
        <div class="flex-shrink-0 text-center sm:text-right">
          <p class="text-4xl font-extrabold text-[var(--color-text-primary)]">2025</p>
          <p class="mt-1 text-sm text-[var(--color-text-tertiary)]">App Launch Year</p>
        </div>
      </div>
    </div>
  </div>
</section>
